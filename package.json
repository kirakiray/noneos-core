{
  "name": "noneos-core",
  "version": "4.3.1",
  "description": "As the core engine of the next generation of NoneOS",
  "homepage": "https://github.com/kirakiray/noneos-core#readme",
  "bugs": {
    "url": "https://github.com/kirakiray/noneos-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirakiray/noneos-core.git"
  },
  "license": "Apache-2.0",
  "author": "Yao",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run static & npm run watch:sw",
    "static": "http-server -p 3002 -c-1 --cors",
    "static2": "http-server -p 30028 -c-1 --cors",
    "ws": "npm run ws1 & npm run ws2",
    "ws1": "cd server/rust && cargo run -- --config test-space/config.example.toml",
    "ws2": "cd server/rust && cargo run -- --config test-space/config2.toml",
    "bump": "node scripts/bump.js && npm i && npm run build",
    "build": "npm run build:hashes && node scripts/pack-nos.js && npm run build:sw && npm run build:skill",
    "build:skill": "node scripts/build-skill.js noneos-core-docs",
    "build:hashes": "node scripts/calculate-nos-hashes.js && node scripts/sign-hashes.js && rm hashes.json",
    "build:sw": "rollup -c",
    "watch:sw": "rollup -c -w",
    "test": "sb-test"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "archiver": "^8.0.0",
    "http-server": "^14.1.1",
    "playwright": "^1.59.1",
    "rollup": "^3.0.0",
    "sibyl-test": "^1.0.13"
  },
  "dependencies": {
    "selenium-webdriver": "^4.43.0"
  }
}
